      </segment>
    </unit>
    <unit id="dashboard.pending.title">
      <segment>
        <source>{count, plural, one {# settlement is pending} other {# settlements are pending}}</source>
      </segment>
    </unit>
    <unit id="dashboard.pending.description">
      <segment>
        <source>The facilitator broadcast these payments but could not confirm them, or it did not answer. The payers did not get the content. Check each transaction on a block explorer before anyone pays again.</source>
      </segment>
    </unit>
