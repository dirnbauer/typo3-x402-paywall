      <segment>
        <source>service_name is ignored: it must be printable ASCII of at most 32 characters.</source>
      </segment>
    </unit>
    <unit id="problem.invalid_service_tags">
      <segment>
        <source>Some service_tags are ignored: at most 5 tags of printable ASCII with at most 32 characters each.</source>
      </segment>
    </unit>
    <unit id="problem.invalid_service_icon_url">
      <segment>
        <source>service_icon_url is ignored: it must be an absolute http(s) URL of at most 2048 characters.</source>
      </segment>
    </unit>
    <unit id="simulator.title">
      <segment>
        <source>x402 payment simulator</source>
      </segment>
    </unit>
    <unit id="simulator.description">
      <segment>
        <source>Plays the client side of an x402 payment against a site of this installation: request a paywalled page, send a payment with an invalid signature or ask the facilitator what it supports. Nothing is paid.</source>
      </segment>
    </unit>
