    <unit id="simulator.scenario.unpaid">
      <segment>
        <source>Request without payment</source>
      </segment>
    </unit>
    <unit id="simulator.scenario.unpaid.description">
      <segment>
        <source>Requests a paywalled page of the site without paying. Expected: 402 with the payment requirements in PAYMENT-REQUIRED.</source>
      </segment>
    </unit>
    <unit id="simulator.scenario.mock_signature">
      <segment>
        <source>Payment with an invalid signature</source>
      </segment>
    </unit>
    <unit id="simulator.scenario.mock_signature.description">
      <segment>
        <source>Answers the 402 like a wallet would, with a well-formed payment whose signature is invalid. Expected: the facilitator rejects it and the site answers 402 with the reason.</source>
      </segment>
    </unit>
    <unit id="simulator.scenario.route_pattern">
      <segment>
        <source>Gated API route</source>
      </segment>
    </unit>
    <unit id="simulator.scenario.route_pattern.description">
      <segment>
        <source>Requests the first entry of gated_route_patterns of the site without paying.</source>
      </segment>
    </unit>
    <unit id="simulator.scenario.facilitator">
      <segment>
        <source>Facilitator capabilities</source>
      </segment>
    </unit>
    <unit id="simulator.scenario.facilitator.description">
      <segment>
        <source>Calls GET /supported of the facilitator configured for the site, with its API key, and checks that it offers exact payments on the network of the site.</source>
      </segment>
    </unit>
