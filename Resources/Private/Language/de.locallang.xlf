<?xml version="1.0" encoding="utf-8"?>
<xliff version="2.0" xmlns="urn:oasis:names:tc:xliff:document:2.0" srcLang="en" trgLang="de">
    <file id="messages" original="messages">
        <unit id="paywall.title">
            <segment>
                <source>Payment required</source>
                <target>Zahlung erforderlich</target>
            </segment>
        </unit>
        <unit id="paywall.pay_button">
            <segment>
                <source>Pay</source>
                <target>Bezahlen</target>
            </segment>
        </unit>
        <unit id="paywall.processing">
            <segment>
                <source>Processing...</source>
                <target>Wird verarbeitet ...</target>
            </segment>
        </unit>
        <unit id="paywall.success">
            <segment>
                <source>Payment accepted, loading content...</source>
                <target>Zahlung akzeptiert, Inhalt wird geladen ...</target>
            </segment>
        </unit>
        <unit id="paywall.powered_by">
            <segment>
                <source>Powered by</source>
                <target>Bereitgestellt durch</target>
            </segment>
        </unit>
        <unit id="paywall.network_prefix">
            <segment>
                <source>via x402 on</source>
                <target>über x402 auf</target>
            </segment>
        </unit>
        <unit id="paywall.resource">
            <segment>
                <source>Resource:</source>
                <target>Ressource:</target>
            </segment>
        </unit>
        <unit id="paywall.error.missing_config">
            <segment>
                <source>Payment configuration is missing.</source>
                <target>Die Zahlungskonfiguration fehlt.</target>
            </segment>
        </unit>
        <unit id="paywall.error.invalid_config">
            <segment>
                <source>Payment configuration is invalid.</source>
                <target>Die Zahlungskonfiguration ist ungültig.</target>
            </segment>
        </unit>
        <unit id="paywall.error.no_wallet">
            <segment>
                <source>No wallet found. Install an EIP-1193 wallet such as MetaMask, Coinbase Wallet or Rabby.</source>
                <target>Keine Wallet gefunden. Installieren Sie eine EIP-1193-Wallet wie MetaMask, Coinbase Wallet oder Rabby.</target>
            </segment>
        </unit>
        <unit id="paywall.error.no_account">
            <segment>
                <source>No wallet account was selected.</source>
                <target>Es wurde kein Wallet-Konto ausgewählt.</target>
            </segment>
        </unit>
        <unit id="paywall.error.wrong_network">
            <segment>
                <source>Please switch your wallet to the required network.</source>
                <target>Bitte wechseln Sie in Ihrer Wallet auf das erforderliche Netzwerk.</target>
            </segment>
        </unit>
        <unit id="paywall.error.signature_cancelled">
            <segment>
                <source>The signature request was cancelled.</source>
                <target>Die Signaturanfrage wurde abgebrochen.</target>
            </segment>
        </unit>
        <unit id="paywall.error.verification_failed">
            <segment>
                <source>The payment was not accepted.</source>
                <target>Die Zahlung wurde nicht akzeptiert.</target>
            </segment>
        </unit>
        <unit id="paywall.error.unexpected">
            <segment>
                <source>An unexpected error occurred. Please try again.</source>
                <target>Ein unerwarteter Fehler ist aufgetreten. Bitte versuchen Sie es erneut.</target>
            </segment>
        </unit>
    </file>
</xliff>
