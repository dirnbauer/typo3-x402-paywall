{
    "name": "webconsulting/typo3-x402-paywall",
    "description": "x402 Paywall - HTTP 402 payment protocol for TYPO3 14 content monetization.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "typo3",
        "x402",
        "payment",
        "paywall",
        "micropayment",
        "ai-agent",
        "monetization",
        "stablecoin",
        "usdc"
    ],
    "authors": [
        {
            "name": "webconsulting",
            "email": "office@webconsulting.at",
            "homepage": "https://www.webconsulting.at",
            "role": "Lead Developer"
        }
    ],
    "homepage": "https://github.com/dirnbauer/typo3-x402-paywall",
    "support": {
        "issues": "https://github.com/dirnbauer/typo3-x402-paywall/issues",
        "source": "https://github.com/dirnbauer/typo3-x402-paywall"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "mcp/sdk": "^0.5",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1.33",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "saschaegerer/phpstan-typo3": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\X402Paywall\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\X402Paywall\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci": "Build/Scripts/runTests.sh -s ci",
        "lint": "Build/Scripts/runTests.sh -s lint",
        "phpstan": "Build/Scripts/runTests.sh -s phpstan",
        "test": "Build/Scripts/runTests.sh -s unit"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "x402_paywall",
            "version": "1.0.2",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    }
}
