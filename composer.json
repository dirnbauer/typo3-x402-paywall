{
    "name": "webconsulting/typo3-x402-paywall",
    "description": "x402 paywall for TYPO3 14: HTTP 402 payment protocol (x402 v2) for pages and API routes, facilitator verification and settlement (x402.org or Coinbase CDP), payment log, backend dashboard, request simulator and MCP tools.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "typo3",
        "x402",
        "payment",
        "paywall",
        "micropayment",
        "ai-agent",
        "monetization",
        "stablecoin",
        "usdc"
    ],
    "authors": [
        {
            "name": "webconsulting",
            "email": "office@webconsulting.at",
            "homepage": "https://www.webconsulting.at",
            "role": "Lead Developer"
        }
    ],
    "homepage": "https://github.com/dirnbauer/typo3-x402-paywall",
    "support": {
        "issues": "https://github.com/dirnbauer/typo3-x402-paywall/issues",
        "source": "https://github.com/dirnbauer/typo3-x402-paywall",
        "docs": "https://github.com/dirnbauer/typo3-x402-paywall/tree/main/Documentation"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.1",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-frontend": "^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.3",
        "saschaegerer/phpstan-typo3": "^3.1",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^9.7"
    },
    "suggest": {
        "ext-sodium": "Signs Coinbase Developer Platform facilitator tokens with Ed25519 API keys.",
        "hn/typo3-mcp-server": "Exposes the tagged x402_* tools (probe, decode_header, gated_pages, stats, transactions) through MCP."
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\X402Paywall\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\X402Paywall\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci": "Build/Scripts/runTests.sh -s ci",
        "lint": "Build/Scripts/runTests.sh -s lint",
        "cgl": "Build/Scripts/runTests.sh -s cgl",
        "cgl:fix": "Build/Scripts/runTests.sh -s cglFix",
        "phpstan": "Build/Scripts/runTests.sh -s phpstan",
        "test": "Build/Scripts/runTests.sh -s unit",
        "test:unit": "Build/Scripts/runTests.sh -s unit",
        "test:functional": "Build/Scripts/runTests.sh -s functional"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "x402_paywall",
            "web-dir": ".Build/public"
        }
    },
    "config": {
        "sort-packages": true,
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    }
}
